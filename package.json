{
  "name": "feather-testing-core",
  "version": "0.7.0",
  "description": "Phoenix Test-inspired fluent testing DSL for Playwright, React Testing Library, and browserless HTTP requests",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/siraj-samsudeen/feather-testing-core"
  },
  "keywords": [
    "testing",
    "playwright",
    "react-testing-library",
    "happy-dom",
    "server-rendered",
    "fluent",
    "dsl",
    "e2e",
    "integration"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright/index.d.ts",
      "import": "./dist/playwright/index.js",
      "default": "./dist/playwright/index.js"
    },
    "./rtl": {
      "types": "./dist/rtl/index.d.ts",
      "import": "./dist/rtl/index.js",
      "default": "./dist/rtl/index.js"
    },
    "./request": {
      "types": "./dist/request/index.d.ts",
      "import": "./dist/request/index.js",
      "default": "./dist/request/index.js"
    },
    "./eslint-plugin": {
      "types": "./dist/eslint-plugin/index.d.ts",
      "import": "./dist/eslint-plugin/index.js",
      "default": "./dist/eslint-plugin/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@testing-library/react": ">=14.0.0",
    "@testing-library/user-event": ">=14.0.0",
    "happy-dom": ">=20.0.0",
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "@testing-library/user-event": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:pw": "playwright test",
    "test:all": "vitest run && playwright test",
    "test:bun": "bun test",
    "lint": "npm run build && eslint ."
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^9.39.5",
    "happy-dom": "~20.14.6",
    "jsdom": "^28.1.0",
    "playwright": "^1.64.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  }
}
